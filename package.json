{
  "name": "code-snippet-manager",
  "displayName": "Code Snippet Manager",
  "description": "Store and manage your code snippets for productivity.",
  "version": "1.0.0",
  "publisher": "saeedm",
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onCommand:extension.saveSnippet",
    "onCommand:extension.insertSnippet",
    "onCommand:extension.saveSelectedText",
    "onCommand:extension.showSnippets"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.saveSnippet",
        "title": "Save Snippet"
      },
      {
        "command": "extension.insertSnippet",
        "title": "Insert Snippet"
      },
      {
        "command": "extension.saveSelectedText",
        "title": "Save Selected Text as Snippet"
      },
      {
        "command": "extension.showSnippets",
        "title": "Show All Snippets"
      }
    ],
    "keybindings": [
      {
        "command": "extension.saveSnippet",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.insertSnippet",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.saveSelectedText",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.saveSelectedText",
          "when": "editorHasSelection",
          "group": "snippets"
        },
        {
          "command": "extension.insertSnippet",
          "when": "editorTextFocus",
          "group": "snippets"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.saveSnippet"
        },
        {
          "command": "extension.insertSnippet"
        },
        {
          "command": "extension.saveSelectedText"
        },
        {
          "command": "extension.showSnippets"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vsce": "^1.94.0"
  }
}
